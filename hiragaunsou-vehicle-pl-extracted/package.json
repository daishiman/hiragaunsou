{
  "name": "hiragaunsou-vehicle-pl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "cf-typegen": "wrangler types",
    "cf:build": "opennextjs-cloudflare build",
    "cf:dry-run": "opennextjs-cloudflare build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply hiragaunsou_vehicle_pl --local",
    "db:migrate:remote": "wrangler d1 migrations apply hiragaunsou_vehicle_pl --remote",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "better-auth": "^1.2.7",
    "drizzle-orm": "^0.45.2",
    "encoding-japanese": "^2.2.0",
    "fflate": "^0.8.3",
    "hono": "^4.6.14",
    "jose": "^6.1.3",
    "next": "^16.2.12"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260730.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.2"
  }
}
