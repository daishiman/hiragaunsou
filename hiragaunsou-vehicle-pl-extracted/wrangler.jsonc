{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiragaunsou-vehicle-pl",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    // /api/* を必ず Worker 先行にルートする(OAuthコールバック横取り防止)
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiragaunsou_vehicle_pl",
      "database_id": "6ca4b9c7-aae4-4a8d-b8a7-5e55637a7f1a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // Google Workspace限定ログインのドメイン。後続でユーザーが確定させるプレースホルダー
    "WORKSPACE_DOMAIN": "example.co.jp",
    "BETTER_AUTH_URL": "http://localhost:8787"
  },
  "observability": {
    "enabled": true
  }
}
