{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiragaunsou-vehicle-pl",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-03",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding(OpenNextのキャッシュ再検証で使用)
      "binding": "WORKER_SELF_REFERENCE",
      "service": "hiragaunsou-vehicle-pl"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiragaunsou_vehicle_pl",
      "database_id": "6ca4b9c7-aae4-4a8d-b8a7-5e55637a7f1a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMPORTS_BUCKET",
      "bucket_name": "hiragaunsou-vehicle-pl-imports"
    },
    {
      // OpenNext ISR/データキャッシュ用(imports監査ファイルとは別バケット)
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "hiragaunsou-vehicle-pl-opennext-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    // Google Workspace限定ログインの許可ドメイン（カンマ区切り）。
    // hiragaunsou.co.jp: 平賀運送本体のドメイン(管理者 h_atsushi@hiragaunsou.co.jp のブートストラップに必要)。
    "WORKSPACE_DOMAINS": "senpai-lab.com,tiermind.co.jp,hiragaunsou.co.jp",
    "BETTER_AUTH_URL": "https://hiragaunsou-vehicle-pl.daishimanju.workers.dev",
    // 初回ログイン時に自動でadminロールを付与するメールアドレス（カンマ区切り）。
    "BOOTSTRAP_ADMIN_EMAILS": "manjumoto.daishi@senpai-lab.com,h_atsushi@hiragaunsou.co.jp"
  },
  // 未設定のままデプロイして「本番だけ500」になるのを防ぐ(設定漏れならデプロイ自体が失敗する)。
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "GOOGLE_CLIENT_ID", "GOOGLE_CLIENT_SECRET"]
  },
  // limits.cpu_ms(課金の安全弁)は有料プラン専用のため設定していない。
  // 無料プランでは 1リクエストあたり CPU 10ms / D1クエリ50本 が既定の上限として効く。
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true
}
