#!/usr/bin/env sh
# push前は共有前の最終ゲートとして、型チェック+全テスト+カバレッジ閾値(80%)を検証する。
# ここで弾くことでPRを作ってからCIで落ちるまでの手戻りを防ぐ。
set -e

PROJECT_DIR="hiragaunsou-vehicle-pl-extracted"

if git diff --name-only "@{push}"...HEAD 2>/dev/null | grep -q "^${PROJECT_DIR}/" \
  || git diff --name-only origin/main...HEAD 2>/dev/null | grep -q "^${PROJECT_DIR}/"; then
  cd "$PROJECT_DIR"
  npm run typecheck
  npm run coverage
fi
